OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-6.1-terra
# Grok für Faktenblatt und Skript; RESEARCH_MODEL kann separat gesetzt werden.
SCRIPT_MODEL=x-ai/grok-4.3
SCRIPT_FALLBACK_MODEL=x-ai/grok-4.20
# Optionales technisches Limit pro Skript-, Teil- oder Korrekturanfrage; sonst Providerstandard.
# SCRIPT_MAX_TOKENS=16000
# RESEARCH_MODEL=x-ai/grok-4.3
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: exact browser/Android origin, no trailing slash (see README).
# VIDEOMAKER_PUBLIC_ORIGIN=https://videomaker.dorfspy.de
DATA_DIR=./data
IMAGE_PLANNER_MODEL=openai/gpt-6.1-sol
IMAGE_MODEL=microsoft/mai-image-2.6-flash
